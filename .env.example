# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_BASE_URL: Custom public domain for the store (e.g., https://yourbrand.com).
# Overrides default host resolution for customer custom design URLs.
PUBLIC_BASE_URL=""

# Supabase Project Configuration (Optional / Disconnected)
# When you are ready to connect to your Supabase project:
# 1. Set your project URL (e.g. https://your-project-ref.supabase.co)
# 2. Set your anon/publishable key (e.g. sb_publishable_... or your anon key)
# 3. Run the schema from supabase_schema.sql in your Supabase SQL Editor.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
